# 大模型 API 配置（OpenAI 兼容接口，可对接 DeepSeek、通义千问等国内服务商）
# 复制本文件为 .env 并填入你的 Key
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat
USER_LLM_EMBEDDING_MODEL=

# 天气查询（和风天气，https://console.qweather.com 免费申请）
# API Host 在控制台「设置」页面查看，形如 abc1234.def.qweatherapi.com（2026 年起旧域名 geoapi/devapi.qweather.com 已停服，必须配置）
USER_QWEATHER_API_KEY=
USER_QWEATHER_API_HOST=

# 网络搜索（Bing Web Search API，Azure 门户申请）
USER_BING_API_KEY=

# 每日星座运势（聚合数据，https://www.juhe.cn 免费申请）
USER_JUHE_API_KEY=
